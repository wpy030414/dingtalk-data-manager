{
  "name": "dingtalk-data-manager",
  "version": "1.0.0",
  "description": "DingTalk Enterprise Data Manager Gateway — MCP server exposing normalized DingTalk Open API data",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "vite build",
    "preview": "node dist/index.js",
    "start": "node dist/index.js",
    "start:http": "tsx src/index.ts --transport http --port 11409",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:unit": "vitest run --dir tests/unit",
    "test:integration": "vitest run --dir tests/integration",
    "test:e2e": "vitest run --dir tests/e2e",
    "lint": "eslint src/ tests/",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "^1.17.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "hono": "^4.10.0",
    "js-yaml": "^4.1.0",
    "pino": "^9.6.0",
    "pino-pretty": "^11.3.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.13.0",
    "@vitest/coverage-v8": "^3.1.0",
    "eslint": "^9.19.0",
    "msw": "^2.7.0",
    "prettier": "^3.4.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vite": "^8.2.2",
    "vitest": "^3.1.0"
  }
}